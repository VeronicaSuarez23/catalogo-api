{
  "name": "catalogo-api",
  "version": "1.0.0",
  "description": "API REST de catálogo de productos y favoritos con JWT y roles (Node.js + Express + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init-db": "node scripts/init-db.js",
    "seed": "node scripts/seed.js",
    "admin": "node scripts/crear-admin.js",
    "test:newman": "newman run postman/Catalogo.postman_collection.json -e postman/Catalogo.postman_environment.json"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "newman": "^6.2.1"
  }
}
